rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Images for shopping list items - path includes userId for security
    match /images/{userId}/{itemId}/{filename} {
      // Allow authenticated users to read images
      allow read: if request.auth != null;

      // Allow users to write images only to their own path
      // Only allow image files (jpg, jpeg, png, gif, webp)
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 10 * 1024 * 1024 && // Max 10MB
                      request.resource.contentType.matches('image/.*');

      // Allow users to delete only their own images
      allow delete: if request.auth != null &&
                       request.auth.uid == userId;
    }
  }
}
